generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())

  // связи
  lots_created  Lot[]    @relation("SellerLots")
  lots_won      Lot[]    @relation("WinnerLots")
  bids          Bid[]
}

model Category {
  id    String @id @default(uuid())
  name  String @unique 
  lots  Lot[]
}

model Image {
  id     String @id @default(uuid())
  url    String 
  lot_id String
  
  lot    Lot    @relation(fields: [lot_id], references: [id])
}

model Lot {
  id             String   @id @default(uuid())
  seller_id      String
  category_id    String
  title          String
  description    String
  starting_price Int    
  current_price  Int     
  min_step       Int      
  end_time       DateTime
  status         String   @default("active")
  winner_id      String?  
  version        Int      @default(1) 

  // серверевязи
  seller         User     @relation("SellerLots", fields: [seller_id], references: [id])
  winner         User?    @relation("WinnerLots", fields: [winner_id], references: [id])
  category       Category @relation(fields: [category_id], references: [id])
  images         Image[]  
  bids           Bid[]
}

model Bid {
  id         String   @id @default(uuid())
  lot_id     String
  user_id    String
  amount     Int
  created_at DateTime @default(now())

  lot        Lot      @relation(fields: [lot_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  // индекс для мгновенной выборки истории ставок
  @@index([lot_id, created_at])
}